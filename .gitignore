# ------------------------------
# Dependencies
# ------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------
# Build / Framework outputs
# ------------------------------
/.next/
/out/
/build
/coverage
/.turbo

# ------------------------------
# Runtime data (do not publish)
# ------------------------------
/data
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*

# ------------------------------
# Local environment & secrets
# ------------------------------
.env
.env.*
.env*.local
!.env.example
!.env.*.example

# ------------------------------
# Runtime configs containing secrets
# ------------------------------
agent/config.json
agent/config.*.json
!agent/config.example.json

# ------------------------------
# Certificate / key material
# ------------------------------
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
id_rsa
id_rsa.pub

# ------------------------------
# Logs / debug
# ------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------
# OS / editor / local tooling
# ------------------------------
.DS_Store
.vscode
.idea
.claude

# ------------------------------
# TypeScript / Next generated
# ------------------------------
*.tsbuildinfo
next-env.d.ts
