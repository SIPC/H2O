# H2O 环境变量示例（开源安全模板）
# 使用方式：
# 1) 复制本文件为 .env.local
# 2) 按需修改
# 3) 不要把 .env.local 提交到 Git

# 运行模式：development / production
NODE_ENV=development

# 业务数据库（SQLite）路径（可选）
# 默认值：./data/h2o.sqlite
H2O_DB_PATH=./data/h2o.sqlite

# 日志数据库（SQLite）路径（可选）
# 默认值：./data/h2o-logs.sqlite
H2O_LOGS_DB_PATH=./data/h2o-logs.sqlite

# Next.js 运行参数（可选）
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# 说明：
# - Turnstile 的 site key / secret key 由后台设置写入数据库（settings 表），不在此文件配置。
# - 本文件不包含任何真实密钥；如需接入外部服务，请仅在 .env.local 填入真实值。
